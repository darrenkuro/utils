{
    "name": "@darrenkuro/utils",
    "version": "0.3.0",
    "description": "Personal utility package with neverthrow, pino, radashi, and tempo",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./node": {
            "import": "./dist/node.js",
            "types": "./dist/node.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm build",
        "release": "pnpm version patch && pnpm publish",
        "release:minor": "pnpm version minor && pnpm publish",
        "release:major": "pnpm version major && pnpm publish",
        "test": "vitest run"
    },
    "keywords": [
        "utils",
        "neverthrow",
        "pino",
        "radashi",
        "tempo"
    ],
    "license": "MIT",
    "author": "Darren Kuro",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@formkit/tempo": "^1.0.0",
        "neverthrow": "^8.2.0",
        "pino": "^9.6.0",
        "pino-pretty": "^13.1.3",
        "radashi": "^12.3.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
